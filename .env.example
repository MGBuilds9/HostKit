# Database
DATABASE_URL=postgresql://hostkit:changeme@localhost:5432/hostkit

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calendar Sync Cron
CRON_SECRET=generate-a-random-secret

# Resend (invite mail, task mail, and passwordless sign-in links).
# Sign-in links are sent only for an existing active user or a pending invite.
RESEND_API_KEY=re_xxxx
RESEND_FROM_ADDRESS=HostKit <notifications@updates.mkguirguis.com>

# Minio / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hostkit
S3_PUBLIC_URL=https://minio.mkgbuilds.com/hostkit

# Public app URLs (used in client-side code)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Push Notifications (optional — push disabled if omitted)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser (safe to be public)
# VAPID_PRIVATE_KEY must remain server-side only — never expose to the client
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mkgbuilds.com

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Host Agent workspace (KITH-2) ──────────────────────────────────────────
# Optional. The /admin/host-agent UI works with local stub replies when these
# are unset. MKG House sets them in Coolify after merge — do not commit secrets.
# Archive store is Postgres (host_threads / host_messages / host_drafts).
# Attachments stay out of v1; no MinIO bucket is required.

# Wake the Airbnb Host agent (id e28d25b4-4284-4306-a5a5-4f32ab4e0986)
HOST_AGENT_WEBHOOK_URL=
HOST_AGENT_WEBHOOK_TOKEN=
HOST_AGENT_ID=e28d25b4-4284-4306-a5a5-4f32ab4e0986

# Optional LiteLLM fallback when the webhook is not configured
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Smarter auto-send unlock. Default OFF. Leave unset/false until Michael
# explicitly unlocks it. Safe Approved templates may still auto-send.
HOST_AGENT_SMARTER_AUTO_SEND=false
